{
    "name": "okta/sdk",
    "description": "PHP Wrapper for the Okta API",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Brian Retterer",
            "email": "brian.retterer@okta.com"
        }
    ],
    "require": {
        "php": ">=7.0 || ^8.0",
        "psr/http-message": "^1.0",
        "php-http/client-common": "^1.1 || ^2.0",
        "php-http/httplug": "^1.1 || ^2.0",
        "php-http/message": "^1.5",
        "php-http/discovery": "^1.2 || ^1.16",
        "php-http/curl-client": "^1.7 || ^2.0",
        "symfony/yaml": "^3.2 || ^4.3 || ^5.0 || ^6.0 || ^7.0",
        "nesbot/carbon": "^1.26 || ^2.0",
        "illuminate/support": "5.5.* || 5.6.* || 5.7.* || 5.8.* || 6.* || 7.*",
        "guzzlehttp/psr7": "^1.4 || ^2.0",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "league/flysystem-memory": "^1.0",
        "cache/filesystem-adapter": "^1.0",
        "vlucas/phpdotenv": "~2.2|^3.3|^4.1",
        "lcobucci/jwt": "^3.3 || ^4.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.0 || ^8.0 || ^9.0",
        "squizlabs/php_codesniffer": "3.*",
        "symfony/var-dumper": "^8.0 || ^7.0 || ^6.0 || ^5.0 || ^4.0 || ^3.4",
        "php-http/mock-client": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Okta\\": "src"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:unit": "phpunit --testsuite=Unit --colors=always",
        "test:integration": "phpunit --testsuite=Integration --colors=always",
        "rebuild-resources": [
            "@delete-resources",
            "@generate-resources",
            "@test",
            "@fix-code"
        ],
        "delete-resources": [
            "rm -rf ./src/Generated"
        ],
        "generate-resources": "cd ./openapi && npm run generator",
        "fix-code": "phpcbf ."
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
